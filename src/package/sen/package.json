{
  "name": "@seihouse/sen",
  "version": "0.4.0",
  "description": "SEIHouse Expanded Novels: an embeddable expanded-narrative engine — expanded reading behavior, structured chapter contracts, Color Codes, Codex behavior, cards, and the narrative surfaces built on them.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/package/sen/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color-codes": {
      "types": "./dist/types/package/sen/color-codes.d.ts",
      "import": "./dist/color-codes.js"
    },
    "./cards": {
      "types": "./dist/types/package/sen/cards.d.ts",
      "import": "./dist/cards.js"
    },
    "./reader-chamber": {
      "types": "./dist/types/package/sen/reader-chamber.d.ts",
      "import": "./dist/reader-chamber.js"
    },
    "./reader-codex": {
      "types": "./dist/types/package/sen/reader-codex.d.ts",
      "import": "./dist/reader-codex.js"
    },
    "./manifestations": {
      "types": "./dist/types/package/sen/manifestations.d.ts",
      "import": "./dist/manifestations.js"
    },
    "./audio": {
      "types": "./dist/types/package/sen/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./story-seed": {
      "types": "./dist/types/package/sen/story-seed.d.ts",
      "import": "./dist/story-seed.js"
    },
    "./chapter-generation": {
      "types": "./dist/types/package/sen/chapter-generation.d.ts",
      "import": "./dist/chapter-generation.js"
    },
    "./harness-generation": {
      "types": "./dist/types/package/sen/harness-generation.d.ts",
      "import": "./dist/harness-generation.js"
    },
    "./codex-cards": {
      "types": "./dist/types/package/sen/codex-cards.d.ts",
      "import": "./dist/codex-cards.js"
    },
    "./styles.css": "./dist/sen.css",
    "./presentation": {
      "types": "./dist/types/package/sen/presentation.d.ts",
      "import": "./dist/presentation.js"
    }
  },
  "peerDependencies": {
    "@seihouse/audio-player": "*",
    "lucide-react": ">=1",
    "motion": ">=12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-focus-lock": ">=2",
    "@seihouse/ui": "0.4.0"
  }
}

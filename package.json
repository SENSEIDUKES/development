{
  "name": "development",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/buildHarnessGenerationApi.mjs && node scripts/buildStorySeedBlueprintApi.mjs && node scripts/buildCodexVoiceApi.mjs && node scripts/buildReaderTranslationApi.mjs && node scripts/buildLibraryEconomyApi.mjs && node scripts/buildModelRouterApi.mjs",
    "preview": "vite preview",
    "build:package": "npm run build:package:sen && npm run build:package:library",
    "build:package:sen": "vite build --config vite.package.config.ts && tsc -p tsconfig.package.json && node scripts/finalizePackage.mjs sen",
    "build:package:library": "node scripts/requirePackageTypes.mjs library && vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node scripts/finalizePackage.mjs library",
    "check:ui-artifacts": "node scripts/checkUIArtifacts.mjs",
    "check:package-boundaries": "node scripts/checkPackageBoundaries.mjs",
    "check:ownership": "node scripts/checkOwnership.mjs",
    "test:package": "npm run check:ui-artifacts && npm run check:package-boundaries && npm run build:package && node scripts/smokePackage.mjs sen && node scripts/smokePackage.mjs library",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ownership": "vitest run scripts/ownershipGraph.test.ts",
    "test:chapter-manifestation": "vitest run src/components/chapter-manifestation",
    "test:harness-generation": "vitest run src/components/harness-generation src/server/harness-generation src/workshop/previews/harness-generation",
    "test:library": "tsc -b && vitest run src/components/library-presentation src/presentation src/components/library-shell src/workshop/previews/library-shell",
    "test:relics": "vitest run src/server/relics src/workshop/previews/relics",
    "test:story-seed": "vitest run src/components/story-seed src/server/story-seed-blueprint",
    "test:user-profile": "vitest run src/components/user-profile",
    "test:energy": "vitest run src/server/energy src/components/energy",
    "test:audio-catalog": "vitest run src/server/audio src/audio/libraryCues.test.ts",
    "test:codex-voice": "vitest run src/server/audio src/components/reader-codex/shared/hooks",
    "test:inline-audio": "vitest run src/audio src/components/reader-chamber/development/InlineAudio.test.tsx src/components/reader-chamber/development/InlineAudio.styles.test.ts",
    "test:dao-pillar": "vitest run src/server/dao-pillar src/server/qi src/components/dao-pillar",
    "test:reader-chamber": "vitest run src/components/reader-chamber",
    "test:reader-codex": "vitest run src/components/reader-codex",
    "test:arc-goals": "vitest run src/components/arc-goals",
    "test:card-workshop": "vitest run src/components/card-workshop",
    "test:closed-door-cultivation": "vitest run src/components/closed-door-cultivation",
    "test:celestial-store": "vitest run src/components/celestial-store",
    "test:familiar": "vitest run src/components/familiar src/host/familiar src/workshop/previews/familiar",
    "test:provenance": "vitest run src/components/provenance src/workshop/ProvenanceTab.test.tsx",
    "test:sen-icons": "vitest run src/components/sen-icons",
    "test:lib": "vitest run src/lib/language.test.ts",
    "test:qi-client": "vitest run src/library/cultivation",
    "test:economy": "vitest run src/server/economy",
    "test:reader-translation": "vitest run src/server/reader-translation",
    "test:public-generation-guard": "vitest run src/server/shared",
    "test:workshop": "vitest run src/workshop/FeatureWorkspace.test.tsx src/workshop/WorkshopHome.test.tsx src/workshop/docs",
    "verify": "npm run typecheck && npm test && npm run check:ownership && npm run check:package-boundaries && npm run test:package"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@seihouse/audio-player": "github:SENSEIDUKES/AUDIO-PLAYER#b1e05870f4c3e9cad2ddb74119371c5c7cba6471",
    "@seihouse/library-ui": "file:vendor/seihouse-library-ui-0.5.0.tgz",
    "@seihouse/ui": "file:vendor/seihouse-ui-0.4.0.tgz",
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "react": "latest",
    "react-dom": "latest",
    "react-focus-lock": "^2.13.7",
    "seihouse-productions-package": "file:vendor/seihouse-productions-package-0.1.0.tgz",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.10"
  }
}

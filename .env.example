# Server-side only. Never prefix these with VITE_ or read them in browser code.
GEMINI_API_KEY=

# Protected Story Seed Blueprint generation. If omitted, the access token and
# model fall back to the matching Chapter Generation settings below.
STORY_SEED_BLUEPRINT_ACCESS_TOKEN=
STORY_SEED_BLUEPRINT_MODEL=google/gemini-3.1-flash-lite
STORY_SEED_BLUEPRINT_MAX_OUTPUT_TOKENS=8192
STORY_SEED_BLUEPRINT_TIMEOUT_MS=90000
STORY_SEED_BLUEPRINT_TEMPERATURE=1

# Comma-separated allow-list shown by the Development model selector.
CHAPTER_GENERATION_ACCESS_TOKEN=
CHAPTER_GENERATION_DEFAULT_MODEL=google/gemini-3.1-flash-lite
CHAPTER_GENERATION_MAX_OUTPUT_TOKENS=16384
CHAPTER_GENERATION_MODELS=google/gemini-3.1-flash-lite
CHAPTER_GENERATION_STAGE_TIMEOUT_MS=90000
CHAPTER_GENERATION_TEMPERATURE=1

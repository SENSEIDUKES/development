{
  "name": "@seihouse/front-desk",
  "version": "0.1.0",
  "description": "SEIHouse Front Desk: an app's front desk in one character. Help, guides, actions it asks before taking, look-ups without spoilers, voice and live talk, built for people who cannot or would rather not use the screen.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/package/front-desk/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docs-knowledge": {
      "types": "./dist/types/package/front-desk/docs-knowledge.d.ts",
      "import": "./dist/docs-knowledge.js"
    },
    "./engines": {
      "types": "./dist/types/package/front-desk/engines.d.ts",
      "import": "./dist/engines.js"
    },
    "./styles.css": "./dist/front-desk.css"
  },
  "peerDependencies": {
    "lucide-react": ">=1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-focus-lock": ">=2",
    "@seihouse/ui": "0.12.0"
  }
}
